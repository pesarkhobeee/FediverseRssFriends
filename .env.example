# rssFriends — production environment file. Copy to `.env` and fill in.
# This is the ONE file every self-hoster needs to customise. Everything
# else (app code, templates, docker-compose) reads from here.

# --- Required ---------------------------------------------------------------

# Public hostname (used by Caddy for TLS + by app for magic-link URLs).
RSSFRIENDS_HOSTNAME=radar.example.com
RSSFRIENDS_BASE_URL=https://radar.example.com

# --- Your instance identity (0.11.34) --------------------------------------
# These reach the nav brand, landing hero, page titles, PWA manifest,
# NodeInfo (visible to Mastodon federation crawlers), and every email
# FROM address. Change them to something that reflects YOUR community.

# The name shown everywhere. Keep it short (< ~24 chars).
RSSFRIENDS_INSTANCE_NAME=rssFriends

# One-liner shown as the landing tagline + <title> subtitle.
RSSFRIENDS_INSTANCE_TAGLINE=A social, RSS-friendly radar for the open web

# Two-sentence description for NodeInfo + PWA manifest description.
RSSFRIENDS_INSTANCE_DESCRIPTION=A self-hosted RSS reader that turns your subscriptions into a public radar others can follow — including from Mastodon, via ActivityPub.

# Shown in the footer as an "Admin" mailto link + published to NodeInfo
# metadata.adminEmail so fediverse crawlers can flag you for issues.
# Leave blank to hide.
RSSFRIENDS_ADMIN_EMAIL=

# Handles allowed to create/edit official collections + moderate every
# system-curated one. Comma-separated. If empty, the FIRST-registered
# user on the instance is the de-facto admin (zero-config path).
RSSFRIENDS_ADMIN_HANDLES=

# Set to 0 to run the instance in invite-only mode. Existing users can
# still sign in, but unknown emails get a friendly "invite-only" error
# on POST /login instead of a magic link.
RSSFRIENDS_OPEN_REGISTRATION=1

# Comma-separated email domains that can neither sign up nor sign in,
# e.g. a throwaway-mail service used for spam signups. Subdomains are
# covered too. Existing accounts on these domains are locked out but
# not deleted.
RSSFRIENDS_BLOCKED_EMAIL_DOMAINS=

# --- Auth signing ----------------------------------------------------------

# Signed-cookie secret. Generate ONCE with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Rotating this invalidates every session AND every stored Wallabag
# credential (they're encrypted with a key derived from this secret).
RSSFRIENDS_SESSION_SECRET=CHANGE-ME-USE-A-LONG-RANDOM-STRING

# --- Magic-link email delivery --------------------------------------------
# Pick ONE of the two paths below (or leave both blank for dev mode —
# the link prints to stdout).
#
# --- Resend (preferred, simplest) ---
# Sign up at resend.com, verify your sending domain, paste the API
# key. Use your verified domain in the From address.
RSSFRIENDS_RESEND_API_KEY=
RSSFRIENDS_RESEND_FROM=rssFriends <no-reply@radar.example.com>

# --- SMTP (fallback) ---
# RSSFRIENDS_SMTP_HOST=smtp.fastmail.com
# RSSFRIENDS_SMTP_PORT=587
# RSSFRIENDS_SMTP_USER=you@example.com
# RSSFRIENDS_SMTP_PASSWORD=app-specific-password
# RSSFRIENDS_SMTP_FROM=rssFriends <no-reply@example.com>
# RSSFRIENDS_SMTP_STARTTLS=1

# --- Optional (defaults shown) ---------------------------------------------

# RSSFRIENDS_MAGIC_LINK_TTL_MINUTES=15
# RSSFRIENDS_MAGIC_LINK_MIN_INTERVAL=60

# Background feed refresh cadence + concurrency.
# RSSFRIENDS_REFRESH_INTERVAL_MINUTES=15
# RSSFRIENDS_REFRESH_BATCH_SIZE=300
# RSSFRIENDS_REFRESH_CONCURRENCY=10
# RSSFRIENDS_FEED_ITEM_KEEP=100
# RSSFRIENDS_ENABLE_SCHEDULER=1

# Backup retention (used by scripts/backup.sh).
# RSSFRIENDS_BACKUP_KEEP=14
